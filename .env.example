# CLARA — environment template
# Copy to .env and fill in. Never commit .env.

# === AI layer (apps/api/app/services/ai.py) — provider-agnostic, OpenAI-compatible ===
# Local-first is the default. API models are optional.
# Local Ollama:   AI_BASE_URL=http://localhost:11434/v1   AI_MODEL=llama3.1   (AI_API_KEY empty)
# Local vLLM:     AI_BASE_URL=http://localhost:8000/v1      AI_MODEL=<served-model> (AI_API_KEY empty)
# OpenAI:         AI_BASE_URL=https://api.openai.com/v1     AI_MODEL=gpt-4o-mini  AI_API_KEY=sk-...
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
AI_MODEL=llama3.1
AI_EMBED_MODEL=nomic-embed-text
AI_EMBED_DIM=768

# === Langfuse (tracing + evals) — self-hosted ===
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# === Database (self-hosted Supabase Postgres) ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
APP_CORS_ORIGINS=http://localhost:3000

# === Supabase Auth (FastAPI verifies Supabase JWTs) ===
SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_ROLE_KEY=
# Set true in ANY real deployment: refuses to boot when auth is unconfigured,
# instead of silently treating every request as role=owner (local-dev fallback).
CLARA_REQUIRE_AUTH=false

# === Connectors (Phase 2) — Zendesk in, Jira + Slack out ===
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# === Web (Next.js) ===
NEXT_PUBLIC_API_URL=http://localhost:8000

# === Scoring weights (8-factor impact model) ===
SCORING_WEIGHT_CUSTOMER_REACH=1.0
SCORING_WEIGHT_SEVERITY=1.25
SCORING_WEIGHT_RECURRENCE=1.0
SCORING_WEIGHT_JOURNEY_CRITICALITY=1.2
SCORING_WEIGHT_ACCOUNT_EXPOSURE=0.9
SCORING_WEIGHT_FINANCIAL_EXPOSURE=0.9
SCORING_WEIGHT_REGULATORY_RISK=1.1
SCORING_WEIGHT_EVIDENCE_CONFIDENCE=1.0

# === Enrichment behaviour (apps/api/app/services/enrichment.py) ===
# Anything that changes the enrichment prompt or tool schema changes the artifact
# that app/evals/published_metrics.json measured, so new fields ship opt-in and
# are enabled as a deliberate eval-improve iteration, not by default.
ENRICH_FEWSHOT=1           # curated few-shot exemplars; 0 disables
ENRICH_TAG_CANON=1         # lexical tag canonicalisation; 0 disables
ENRICH_SIGNAL_BASIS=0      # add evidence_basis: reported_event | mixed | opinion
ENRICH_SIGNAL_TYPE=0       # add signal_type: bug | feature_request | complaint |
                           #   praise | question | churn_risk | compliance_concern

# === Frequency analysis ===
FREQUENCY_HALF_LIFE_DAYS=30
FREQUENCY_RECENT_WINDOW_DAYS=7
FREQUENCY_BASELINE_WINDOW_DAYS=30

# === Clustering thresholds ===
CLUSTER_JACCARD_THRESHOLD=0.34
CLUSTER_SEMANTIC_THRESHOLD=0.70
CLUSTER_MIN_SIZE=3
CLUSTER_MIN_SOURCES=1

# Connector-secret encryption at rest (generate:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# Unset = plaintext (local dev only). Legacy rows re-seal on next save.
CLARA_CONFIG_SECRET_KEY=

# Weekly digest email (recipient = workspace notification_email in Settings).
CLARA_SMTP_HOST=
CLARA_SMTP_PORT=587
CLARA_SMTP_USER=
CLARA_SMTP_PASSWORD=
CLARA_SMTP_FROM=
