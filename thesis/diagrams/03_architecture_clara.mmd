%% Implementation architecture — CLARA build (Next.js + FastAPI + LangGraph). Edit freely.
%% CLARA = Capture, Listen, Analyze, Respond, Adapt. Updated Sep 2026 to the deployed graph.
flowchart TB
    subgraph FE["Frontend · Vercel"]
        UI["Next.js + TypeScript<br/>shadcn/ui · Tailwind"]
    end

    subgraph API["Backend · Docker on an EU VPS (Caddy reverse proxy)"]
        FAST["FastAPI (Python)<br/>~89 REST endpoints · 7 routers<br/>role-gated · rate limiter · API keys"]
        subgraph LG["LangGraph triage graph"]
            N0["ingest"]
            N1["enrich<br/>+ few-shot exemplars<br/>identifiers redacted"]
            N1b["classify<br/>taxonomy mapping"]
            N2["synthesize<br/>+ retrieved learnings"]
            N3["governance<br/>policy checks"]
            INT{{"approval<br/>interrupt: human decision · Art 14"}}
            N4["action"]
            N5["measure"]
            N6["learn"]
        end
        PUSH["action_push<br/>Jira/Slack write on approval<br/>idempotent · draft fallback"]
        SCHED["measurement scheduler<br/>t7 · window · follow-up<br/>ITS · evidence grade · loop verdict"]
    end

    subgraph DATA["Data"]
        DB[("PostgreSQL + pgvector · RLS forced<br/>clara_signals · clara_theme_insights · clara_problems<br/>clara_workflow_records · clara_measurement_plans<br/>clara_learnings · taxonomy_nodes · clara_telemetry")]
        XSTORE[("exemplar store")]
    end

    AI["ai.py · provider-agnostic LLM<br/>hosted or self-hosted (Ollama/vLLM)<br/>EU-only residency gate"]
    OBS["Langfuse<br/>LLM tracing / observability"]
    CONN["Connectors (SSRF-guarded)<br/>Jira · Slack · Zendesk · App Store · Google Play · Trustpilot · Google Business"]

    UI --> FAST --> LG
    LG --> DB
    N0 --> N1 --> N1b --> N2 --> N3 --> INT --> N4 --> N5 --> N6
    N1 --> AI
    N2 --> AI
    LG --> OBS
    N4 --> PUSH --> CONN
    N5 --> SCHED --> DB
    N6 --> DB
    DB -.->|"decayed-confidence retrieval<br/>(remedy adoption 21%→71%)"| N2
    XSTORE -.->|"label vocabulary + urgency rubric"| N1
