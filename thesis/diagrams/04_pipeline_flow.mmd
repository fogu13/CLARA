%% Data pipeline — Signal → Insight → Action → Learning, with governance control points. Edit freely.
flowchart TD
    A["Raw signal<br/>(feedback text + source, journey, language)"] --> B["Enrich<br/>sentiment · urgency · theme tags<br/>identifiers redacted before the model call<br/>journey-stage routing: closed set, may abstain (flag)"]
    B --> C["Classify<br/>map to the workspace taxonomy catalog"]
    C --> D["Synthesise insight<br/>cluster by theme · composite cross-signal severity<br/>+ retrieved past learnings"]
    D --> E["Problem candidates<br/>journey/stage groups · AI themes"]
    E --> F{"Human accepts<br/>candidate?"}
    F -->|reject| X0["Logged · no problem"]
    F -->|accept| G["Problem record<br/>outcome contract proposed at approval<br/>action proposals with risk level · policy checks"]
    G --> H{"Human approves<br/>the action?<br/>(blocking policy check withholds it)"}
    H -->|reject| X["Logged · no action"]
    H -->|approve| I["Execute<br/>Jira / Slack push, draft fallback"]
    I --> J["Audit record<br/>reviewer · executor · connector result<br/>evidence pack hashed at decision time"]
    J --> K["Measure<br/>t7 · window · follow-up checkpoints<br/>ITS readout · evidence grade A–E"]
    K --> L{"Loop verdict"}
    L -->|"loop closed"| M["Reviewer records learning conclusion<br/>worked · partially · did not work · inconclusive"]
    L -->|"fix did not land"| M
    L -->|"measuring"| K
    M --> N["Learning memory<br/>base confidence · half-life · reviewer"]
    N -->|"decayed-confidence retrieval"| D

    classDef gov fill:#fde2e2,stroke:#c0392b,color:#7b1f1f;
    classDef llm fill:#e2ecfd,stroke:#3b6ea5,color:#1f3b5b;
    class F,H,J,M gov;
    class B,D llm;
