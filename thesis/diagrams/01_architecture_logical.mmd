%% Logical system architecture (build-agnostic). Edit freely.
%% Render: paste into Obsidian / mermaid.live / VS Code Mermaid preview, or import into draw.io.
flowchart LR
    subgraph SRC["Feedback sources (integrate, not rebuild)"]
        S1["Surveys<br/>NPS / CSAT / CES"]
        S2["Support<br/>Zendesk"]
        S3["Reviews<br/>App Store · Google Play · Trustpilot · Google Business"]
        S4["CSV / JSON import"]
    end

    subgraph ING["Ingestion"]
        I1["Validation · language detection<br/>authenticity flags (annotated, not enforced)"]
    end

    subgraph CORE["Governed loop · Signal to Insight to Action to Learning"]
        E["Enrichment<br/>sentiment · urgency · theme tags<br/>(identifiers redacted before the model call)"]
        SY["Synthesis<br/>theme clusters · cross-signal severity"]
        C["Problem candidates<br/>journey/stage groups · AI themes"]
        H1{"Human accepts<br/>candidate?"}
        P["Problem + outcome contract<br/>action proposals · policy checks"]
        AP{"Human approves<br/>each action?"}
        EX["Execute<br/>Jira / Slack push · draft fallback"]
        M["Measurement<br/>t7 · window · follow-up checkpoints<br/>ITS readout · evidence grade · loop verdict"]
        L["Learning memory<br/>reviewed conclusions · confidence decay"]
    end

    subgraph OUT["Execution targets (integrate)"]
        O1["Jira / Slack"]
    end

    subgraph GOV["Responsible-AI governance (cross-cutting)"]
        G1["Audit trail · evidence-pack hash · CSV export"]
        G2["Provenance labels · Article 50 status"]
        G3["Policy rules · works-council mode"]
        G4["Model sovereignty · EU residency gate"]
    end

    S1 --> I1
    S2 --> I1
    S3 --> I1
    S4 --> I1
    I1 --> E --> SY --> C --> H1
    H1 -->|"accepted"| P --> AP
    H1 -->|"rejected"| X1["Logged · no problem"]
    AP -->|"approved"| EX
    AP -->|"rejected"| X2["Logged · no action"]
    EX --> O1
    EX --> M --> L
    L -.->|"retrieved into synthesis"| SY
    G1 -.-> EX
    G2 -.-> E
    G3 -.-> AP
    G4 -.-> E
