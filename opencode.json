{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.5",
  "small_model": "openai/gpt-5.4-mini",
  "default_agent": "odradek-lead",
  "share": "disabled",
  "instructions": [
    "AGENTS.md"
  ],
  "plugin": [
    "/Users/olamakri/Developer/tools/ponytail/.opencode/plugins/ponytail.mjs"
  ],
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.crt": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      "~/.ssh/**": "deny",
      ".env.example": "allow",
      "**/.env.example": "allow"
    },
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "edit": "deny",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch --show-current": "allow",
      "git rev-parse*": "allow",
      "git worktree list*": "allow",
      "npm run api:test": "allow",
      "npm run web:lint": "allow",
      "npm run web:build": "allow",
      "npm run check": "allow",
      "git push --force*": "deny",
      "git push*": "deny",
      "git merge*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git switch main": "deny",
      "git checkout main": "deny",
      "vercel deploy*": "deny",
      "vercel deploy --prod*": "deny",
      "vercel * --prod*": "deny",
      "vercel --prod*": "deny",
      "supabase migration repair*": "deny",
      "supabase migration squash*": "deny",
      "supabase db reset*": "deny",
      "supabase db push*": "deny",
      "docker system prune*": "deny",
      "docker volume prune*": "deny",
      "docker compose down -v*": "deny",
      "rm -rf*": "deny"
    },
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": {
      "*": "ask",
      "~/.ssh/**": "deny",
      "~/.local/share/opencode/auth.json": "deny"
    }
  }
}
