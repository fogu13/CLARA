# Local development.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production should be set in Vercel Project Settings, not committed here.
# NEXT_PUBLIC_API_URL=https://your-fastapi-api-domain

# Supabase auth (sign-in). When both are set, the dashboard requires a login; when unset,
# the app runs against an auth-disabled API (local dev). Get these from Supabase →
# Project Settings → API (Project URL + the publishable/anon key).
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
