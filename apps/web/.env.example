# Local development.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production should be set in Vercel Project Settings, not committed here.
# NEXT_PUBLIC_API_URL=https://your-fastapi-api-domain

# Supabase auth (sign-in). When both are set, the dashboard requires a login; when unset,
# the app runs against an auth-disabled API (local dev). Get these from Supabase →
# Project Settings → API (Project URL + the publishable/anon key).
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# HttpOnly-cookie sessions (docs/engineering/auth-hardening-design.md).
# Set BOTH on the canonical production domain only — Vercel previews are
# cross-site with the API and must keep the legacy flow (leave unset there).
# NEXT_PUBLIC_COOKIE_AUTH=1
# AUTH_COOKIE_DOMAIN=clara.odradekai.com
# Optional MFA mandate (API-side env, NOT here): CLARA_REQUIRE_AAL2=true on the
# API rejects password-only sessions once every user has enrolled a TOTP factor.

# Legal pages (/legal/impressum, /legal/datenschutz, /legal/agb) render the
# reviewed markdown from apps/web/content/legal/ at BUILD time. Double-gated:
# this flag AND no DRAFT banner / {{placeholders}} left in the documents.
# NEXT_PUBLIC_LEGAL_PAGES=1

# Public-site conversion links. Unset → CTAs fall back to a prefilled mailto.
# Create free Cal.com event types and paste their URLs, then redeploy:
#   NEXT_PUBLIC_BOOKING_URL          → "Pilot scoping call — 30 min" (commercial)
#   NEXT_PUBLIC_RESEARCH_BOOKING_URL → "Research interview — 30 min" (thesis, no pitch)
#   NEXT_PUBLIC_SURVEY_URL           → the ~5-min survey form (shown only when set)
# NEXT_PUBLIC_BOOKING_URL=https://cal.com/YOUR_HANDLE/clara-pilot
# NEXT_PUBLIC_RESEARCH_BOOKING_URL=https://cal.com/YOUR_HANDLE/clara-research
# NEXT_PUBLIC_SURVEY_URL=
