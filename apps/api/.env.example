# Local development defaults to SQLite when DATABASE_URL is not set.
# CLARA_DB_PATH=apps/api/.data/clara.db

# Production API deployments should set this to the Supabase Postgres URL.
# Use Supabase's transaction pooler for serverless hosts and session/direct
# connections for long-running FastAPI hosts.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:PORT/postgres

# Comma-separated frontend origins allowed to call the API.
APP_CORS_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app

# --- Auth (Supabase JWT) ---
# SUPABASE_URL drives JWKS verification of ES256 tokens (the modern Supabase default);
# SUPABASE_JWT_SECRET is only needed for legacy HS256 projects. Set at least one in prod.
SUPABASE_URL=https://YOUR_REF.supabase.co
# SUPABASE_JWT_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
# Fail closed: refuse to boot if auth is unconfigured (don't fall back to role=owner).
CLARA_REQUIRE_AUTH=true

# --- AI provider (OpenAI-compatible) ---
# One base URL serves BOTH chat and embeddings — you cannot split providers.
# The embed defaults below are Google's; against any other AI_BASE_URL they must
# be overridden or every embedding call (Insights search, taxonomy bootstrap,
# duplicate detection) fails with a 4xx from the provider.
AI_BASE_URL=https://api.mistral.ai/v1
AI_MODEL=mistral-small-latest
# AI_API_KEY=your-mistral-api-key
# Defaults: AI_EMBED_MODEL=gemini-embedding-001, AI_EMBED_DIM=768.
# For Mistral: mistral-embed is 1024-dim and 422s on the `dimensions` param,
# so set DIM=0 to stop sending it. NOTE: taxonomy_nodes.embedding is vector(768)
# (migration 003) — a 1024-dim model needs a migration before taxonomy bootstrap.
AI_EMBED_MODEL=mistral-embed
AI_EMBED_DIM=0

# Set to 0 to start with an EMPTY workspace (pilots). Default 1 seeds demo signals/problems/context.
CLARA_SEED_DEMO_DATA=1

# Per-client API rate limit (requests/minute; 0 or unset = disabled).
# Per-process fixed window — see RateLimitMiddleware in app/main.py.
CLARA_RATE_LIMIT_PER_MINUTE=120

# Founder/owner bootstrap — comma-separated emails always resolved as `owner`,
# regardless of Supabase app_metadata. Prevents lock-out when no admin exists
# yet. Set to your own login. Others get roles via app_metadata / set_user_role.
CLARA_OWNER_EMAILS=you@example.com
